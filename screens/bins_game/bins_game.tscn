[gd_scene format=3]

[ext_resource type="Script" path="res://screens/bins_game/bins_game.gd" id="1_s"]
[ext_resource type="PackedScene" path="res://ui/components/drag_item.tscn" id="2_d"]
[ext_resource type="PackedScene" path="res://ui/components/round_timer.tscn" id="3_t"]
[ext_resource type="Script" path="res://ui/components/autofit_label.gd" id="4_a"]

[node name="BinsGame" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_s")

[node name="Background" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_type_variation = &"ScreenBackground"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 40
theme_override_constants/margin_top = 60
theme_override_constants/margin_right = 40
theme_override_constants/margin_bottom = 40

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="TopBar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="ExitButton" type="Button" parent="Margin/VBox/TopBar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(240, 110)
layout_mode = 2
theme_type_variation = &"SecondaryButton"
text = "Выйти"

[node name="Spacer" type="Control" parent="Margin/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Progress" type="Label" parent="Margin/VBox/TopBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"HeadingLabel"
text = "0 / 0"

[node name="Card" type="PanelContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"CardPanel"

[node name="CardVBox" type="VBoxContainer" parent="Margin/VBox/Card"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Question" type="Label" parent="Margin/VBox/Card/CardVBox"]
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "В какой бак?"
horizontal_alignment = 1

[node name="Drag" parent="Margin/VBox/Card/CardVBox" instance=ExtResource("2_d")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Hint" type="Label" parent="Margin/VBox/Card/CardVBox"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Перетащи картинку в нужный бак"
horizontal_alignment = 1

[node name="Caption" type="Label" parent="Margin/VBox/Card/CardVBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
theme_type_variation = &"HeadingLabel"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3
script = ExtResource("4_a")
max_font_size = 46
min_font_size = 22
max_height = 170.0

[node name="Feedback" type="Label" parent="Margin/VBox/Card/CardVBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 90)
layout_mode = 2
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

[node name="Timer" parent="Margin/VBox/Card/CardVBox" instance=ExtResource("3_t")]
unique_name_in_owner = true
layout_mode = 2

[node name="Bins" type="HFlowContainer" parent="Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
alignment = 1
