[gd_scene format=3]

[ext_resource type="Script" path="res://screens/editor/waste_row.gd" id="1_s"]

[node name="WasteRow" type="PanelContainer"]
offset_right = 1000.0
offset_bottom = 190.0
theme_type_variation = &"RowPanel"
script = ExtResource("1_s")

[node name="HBox" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 22

[node name="Thumb" type="TextureRect" parent="HBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 150)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Info" type="VBoxContainer" parent="HBox"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="HBox/Info"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3
max_lines_visible = 3
text_overrun_behavior = 3

[node name="Tags" type="HFlowContainer" parent="HBox/Info"]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8

[node name="Warn" type="Label" parent="HBox/Info"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TagLabel"
theme_override_colors/font_color = Color(0.85, 0.2, 0.25, 1)
autowrap_mode = 3

[node name="Chevron" type="Label" parent="HBox"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"HeadingLabel"
text = "›"
